# --- Object storage: any S3 API (SeaweedFS in this repo; MinIO / AWS S3 / ArvanCloud also work) -----
S3_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=demandops
AWS_SECRET_ACCESS_KEY=change-me
S3_ACCESS_KEY=demandops            # used by docker compose
S3_SECRET_KEY=change-me
LANDING_URI=s3://demandops-landing
FEATURES_URI=s3://demandops-features
# --- MLflow ---------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:8333
MODEL_NAME=demand-forecaster
MODEL_ALIAS=champion
# --- Postgres (forecast table) ---------------------------------------
DATABASE_URL=postgresql+psycopg2://demandops:change-me@localhost:5432/demandops
# --- Redis (Feast online store) --------------------------------------
REDIS_URL=localhost:6379
# --- Airflow / alerting / GitOps ---------------------------------------
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
SMTP_HOST=localhost
ALERT_EMAIL_TO=you@example.com
GITOPS_REPO=your-user/demandops
GITOPS_TOKEN=
# --- Local dev ---------------------------------------------------------
DEMANDOPS_DATA_DIR=data
DEMANDOPS_N_SERIES=100
SIMULATOR_START_DAY=1913
STREAMLIT_PORT=8501
